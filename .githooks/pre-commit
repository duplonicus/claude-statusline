#!/usr/bin/env bash
# Pre-commit hook: block staged changes that contain known secret patterns.
# To enable once: git config core.hooksPath .githooks
set -euo pipefail

# Scan the staged diff itself, not a file list rebuilt from it: a rebuilt list
# loses renamed files, paths git quotes (non-ASCII) and paths with spaces. A
# failing git diff stops the commit (set -e) instead of passing it.
staged_diff=$(git diff --cached -U0 --no-color --no-ext-diff)
diff_added=$(printf '%s\n' "$staged_diff" | grep -E "^\+" || true)
if [ -z "$diff_added" ]; then
  exit 0
fi

patterns=(
  'ops_[A-Za-z0-9._-]{20,}'              # 1Password service account tokens
  'sk-ant-[A-Za-z0-9_-]{20,}'            # Anthropic API keys
  'sk-[A-Za-z0-9]{20,}'                  # OpenAI-style keys
  'AIza[A-Za-z0-9_-]{20,}'               # Google API keys
  'gho_[A-Za-z0-9]{20,}'                 # GitHub OAuth tokens
  'ghp_[A-Za-z0-9]{20,}'                 # GitHub PATs
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'   # Any private key
  '"refresh_token"\s*:\s*"[^"]{20,}"'    # OAuth refresh tokens in JSON
  '"client_secret"\s*:\s*"[^"]{20,}"'    # OAuth client secrets
)

status=0
for p in "${patterns[@]}"; do
  if printf '%s\n' "$diff_added" | grep -Eq -- "$p"; then
    echo "pre-commit: suspected secret pattern detected ($p)." >&2
    status=1
  fi
done

exit $status
